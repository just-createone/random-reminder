# Public HTTPS deployment settings.
# Copy this file to .env.public on the target server and replace both values.

# A public domain whose A/AAAA record already points to the server.
APP_DOMAIN=reminder.example.com

# Contact address used by Caddy for TLS certificate notices.
CADDY_EMAIL=admin@example.com

# Web Push contact address. Use a real monitored mailbox on the target server.
VAPID_SUBJECT=mailto:admin@example.com
