{
    email {$CADDY_EMAIL}
}

{$APP_DOMAIN} {
    encode zstd gzip

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), geolocation=(), microphone=()"
    }

    reverse_proxy app:8000 {
        health_uri /health
    }
}
