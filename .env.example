# 运行环境：development 或 production
RANDOM_REMINDER_ENV=development

# 是否开放调试功能和测试接口
RANDOM_REMINDER_DEBUG=true

# 应用监听地址
# 开发环境通常使用 127.0.0.1
# 部署环境通常使用 0.0.0.0
RANDOM_REMINDER_HOST=127.0.0.1

# 应用监听端口
RANDOM_REMINDER_PORT=8000

# 日志级别
RANDOM_REMINDER_LOG_LEVEL=INFO

# SQLite 数据库路径
RANDOM_REMINDER_DB_PATH=random_reminder.db

# VAPID 密钥目录
RANDOM_REMINDER_VAPID_DIR=secrets/vapid

# Web Push 联系地址
VAPID_SUBJECT=mailto:your-email@example.com

# 数据库备份目录
RANDOM_REMINDER_BACKUP_DIR=backups

# 无论文件多旧，至少保留最近多少份备份
RANDOM_REMINDER_BACKUP_KEEP_LATEST=30

# 超过多少天的备份允许被清理
RANDOM_REMINDER_BACKUP_MAX_AGE_DAYS=90